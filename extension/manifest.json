{
  "manifest_version": 3,
  "name": "Lecture AI Summarizer",
  "version": "1.0.0",
  "description": "Summarize lecture pages and selected text into concise study notes.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://lecture-ai-summarizer-coderankitraj.onrender.com/*"
  ],
  "action": {
    "default_title": "Lecture AI Summarizer",
    "default_popup": "popup.html"
  }
}
